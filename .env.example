# ===================================================================
# Sonic Gestión Bot - Variables de Entorno de Producción
# ===================================================================

# Token de autenticación del Bot de Discord (Obtenido en Discord Developer Portal)
BOT_TOKEN=tu_token_de_discord_aqui

# Clave de la API de YouTube Data v3 (Google Cloud Console)
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Prefijo por defecto para invocar los comandos (ej. !, ?, ., $)
# NOTA: También puede ser modificado dinámicamente en vivo con !prefix o !setup
PREFIX=!

# Ruta a la base de datos de producción SQLite (usar volumen persistente en Docker)
DATABASE_URL="file:/app/data/production.db"

# Entorno de ejecución (production | development)
NODE_ENV=production

# ⚠️ SEGURIDAD EN PRODUCCIÓN: NUNCA ACTIVAR ESTA FLAG EN PRODUCCIÓN.
# Debe permanecer siempre en 'false' para evitar el vaciado accidental de las tablas.
RESET_DB_ON_START=false
DEV_RESET_DB=false

# Canales de Discord predeterminados (Opcionales, pueden configurarse con !canales o !setup)
# HISTORY_CHANNEL_ID=123456789012345678
# ADMIN_CHANNEL_ID=123456789012345678
